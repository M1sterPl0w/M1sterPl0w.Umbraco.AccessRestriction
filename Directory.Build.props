<Project>
  <!--
    The Umbraco major this branch targets. main builds Umbraco 18; release/v17 builds Umbraco 17.
    The package version major must match it (see Directory.Build.targets).
  -->
  <PropertyGroup>
    <UmbracoMajor>18</UmbracoMajor>
    <UmbracoNextMajor>$([MSBuild]::Add($(UmbracoMajor), 1))</UmbracoNextMajor>
  </PropertyGroup>
</Project>
